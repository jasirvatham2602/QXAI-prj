SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
FRONTEND_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,https://qxai-fullstack-prj.netlify.app
# Put the following in .env.worker.local, never the frontend:
# SUPABASE_SECRET_KEY=sb_secret_your_worker_secret
# Optional local development admin login; keep disabled in deployed services.
# QXAI_ENV=development
# QXAI_ENABLE_LOCAL_ADMIN=true
# QXAI_LOCAL_ADMIN_USERNAME=admin
# QXAI_LOCAL_ADMIN_PASSWORD_HASH=<salted hash, never a plaintext password>
